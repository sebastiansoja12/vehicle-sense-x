{
  "name": "vehiclesensex-mobile",
  "version": "0.4.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/base-64": "^1.0.2",
    "base-64": "^1.0.0",
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.22",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.23",
    "expo-notifications": "~58.1.10",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.33",
    "expo-sharing": "~58.0.24",
    "expo-speech": "~58.0.4",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:web": "expo export --platform web --clear",
    "export:native": "expo export --platform ios --platform android",
    "verify": "npm test && npm run typecheck && npm run lint",
    "build:native-check": "npx eas-cli@latest build --platform all --profile native-check",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.1"
    }
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-bluetooth-classic"
        ]
      }
    }
  }
}
