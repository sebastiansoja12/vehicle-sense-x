# Server only. Never put the OpenAI key in mobile/ or EXPO_PUBLIC_*.
OPENAI_API_KEY=
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 32-512 characters: letters, numbers, dot, underscore, tilde, hyphen.
APP_API_TOKEN=
OPENAI_MODEL=gpt-5-mini
HOST=127.0.0.1
PORT=8787
# Optional exact browser origins, comma separated, no wildcard or trailing slash.
ALLOWED_ORIGINS=
# Integer 100-30000 milliseconds. Default 25000.
ASSISTANT_TIMEOUT_MS=25000
# Part prices: production eBay Developer credentials with Browse API access.
# Keep both secrets on the server; never use EXPO_PUBLIC_* for credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional dedicated OSM providers (HTTPS). Public defaults are for modest private use.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
